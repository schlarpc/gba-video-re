+/* Shrek perf instrumentation (tmp/shrek/perf). Exported as retro_perf_* through link.T. */
+#ifndef GBA_PERF_H
+#define GBA_PERF_H
+#include <stdint.h>
+#include <string.h>
+
+#define PERF_NB 64          /* function buckets (from the PC LUT) */
+#define PERF_NCTX 4         /* execution context: 0 main, 1 irq dispatch, 2/3 handler ids */
+#define PERF_NK (PERF_NB * PERF_NCTX)
+#define PERF_NSNAP 1024
+
+/* LUT entry: bits 0-5 bucket, bits 8-10 ctx-set (value+1, 0 = none), bit 11 pop ctx, bit 12 snapshot event */
+#define PERF_F_POP 0x0800
+#define PERF_F_EVENT 0x1000
+
+struct PerfCounters {
+	uint64_t now;                /* global cycle time at snapshot */
+	uint64_t elapsed;            /* sum of timing ticks */
+	uint64_t cyc[PERF_NK];       /* cycles charged to instructions */
+	uint64_t ins[PERF_NK];
+	uint64_t memcyc[PERF_NK];    /* cycles charged by data accesses (incl. base) */
+	uint64_t memwait[PERF_NK];   /* waitstate part of data accesses */
+	uint64_t fetchwait[PERF_NK]; /* seq-fetch waitstates (approx: activeSeqCycles per insn) */
+	uint64_t halted, blocked, irq_entry_cyc, irqs;
+	uint64_t dma_units[4], dma_bytes[4], dma_cyc[4];
+	uint64_t matrix_cmds, matrix_bytes;
+	/* CPU data traffic per region (addr>>24 & 15) */
+	uint64_t rd_n[PERF_NCTX][16], wr_n[PERF_NCTX][16], rd_b[PERF_NCTX][16], wr_b[PERF_NCTX][16], rd_w[PERF_NCTX][16], wr_w[PERF_NCTX][16];
+	uint64_t fetch_b[16];
+	uint64_t matrix_cmds_ctx[PERF_NCTX];
+	uint64_t dma_rd_b[16], dma_wr_b[16];
+	/* CPU VRAM writes by raster state: 0 active (not hblank), 1 hblank (visible line), 2 vblank */
+	uint64_t vram_wr_b[3];
+};
+
+struct PerfSnap {
+	uint32_t pc, ctx, vcount, pad;
+	struct PerfCounters c;
+};
+
+extern struct PerfCounters perfC;
+extern uint16_t perf_lut_bios[0x2000], perf_lut_ewram[0x20000], perf_lut_iwram[0x4000];
+extern uint32_t perf_key;         /* current ctx*NB + bucket */
+extern uint32_t perf_ctx;
+extern int perf_enabled;
+
+void perf_event(void* cpu, uint32_t pc, uint16_t e);
+void perf_irq_raise(void* cpu, int32_t cycles);
+
+static inline uint16_t perf_lut(uint32_t pc) {
+	switch (pc >> 24) {
+	case 0: return pc < 0x4000 ? perf_lut_bios[pc >> 1] : 62;
+	case 2: return perf_lut_ewram[(pc & 0x3FFFF) >> 1];
+	case 3: return perf_lut_iwram[(pc & 0x7FFF) >> 1];
+	case 8: case 9: return 61;
+	default: return 63;
+	}
+}
+#endif
