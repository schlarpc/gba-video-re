diff -ruN -x '*.o' -x '*.so' -x '*.d' /nix/store/b8dbfhgr2g5sbzycwcwmamp5viwgk8qp-source/src/gba/perf.c mgba-src/src/gba/perf.c
--- /nix/store/b8dbfhgr2g5sbzycwcwmamp5viwgk8qp-source/src/gba/perf.c	1969-12-31 16:00:00.000000000 -0800
+++ mgba-src/src/gba/perf.c	2026-11-06 13:15:55.593163498 -0800
@@ -0,0 +1,140 @@
+#include <mgba/internal/gba/perf.h>
+#include <mgba/internal/arm/arm.h>
+#include <mgba/internal/gba/gba.h>
+#include <mgba/internal/gba/io.h>
+
+struct PerfCounters perfC;
+uint16_t perf_lut_bios[0x2000], perf_lut_ewram[0x20000], perf_lut_iwram[0x4000];
+uint32_t perf_key, perf_ctx;
+int perf_enabled = 1;
+static uint32_t ctx_stack[64];
+static int ctx_sp;
+static struct PerfSnap snaps[PERF_NSNAP];
+static uint32_t snap_w, snap_r;
+static uint32_t snap_lost;
+
+void perf_event(void* vcpu, uint32_t pc, uint16_t e) {
+	struct ARMCore* cpu = vcpu;
+	if (e & PERF_F_EVENT) {
+		struct GBA* gba = (struct GBA*) cpu->master;
+		if (snap_w - snap_r >= PERF_NSNAP) { ++snap_lost; }
+		else {
+			struct PerfSnap* s = &snaps[snap_w % PERF_NSNAP];
+			perfC.now = perfC.elapsed + (int64_t) cpu->cycles;
+			s->pc = pc; s->ctx = perf_ctx; s->vcount = gba->video.vcount;
+			s->c = perfC;
+			++snap_w;
+		}
+	}
+	if (e & 0x700) {
+		perf_ctx = ((e >> 8) & 7) - 1;
+		if (perf_ctx == 0) ctx_sp = 0; /* main-loop code only runs at the outermost level */
+	}
+}
+
+void perf_irq_raise(void* vcpu, int32_t cycles) {
+	(void) vcpu;
+	if (ctx_sp < 64) ctx_stack[ctx_sp++] = perf_ctx;
+	perf_ctx = 1;
+	perf_key = PERF_NB * 1 + 60;
+	perfC.cyc[perf_key] += cycles;
+	perfC.irq_entry_cyc += cycles;
+	++perfC.irqs;
+}
+
+void perf_pop(void) {
+	if (ctx_sp > 0) perf_ctx = ctx_stack[--ctx_sp];
+}
+
+/* ---- exported API (ctypes) */
+void* retro_perf_counters(void) { return &perfC; }
+int retro_perf_counters_size(void) { return sizeof(perfC); }
+int retro_perf_snap_size(void) { return sizeof(struct PerfSnap); }
+void retro_perf_reset(void) {
+	uint64_t el = perfC.elapsed;
+	memset(&perfC, 0, sizeof(perfC));
+	perfC.elapsed = el;
+}
+void retro_perf_lut_set(uint32_t pc0, uint32_t pc1, uint32_t val) {
+	for (uint32_t pc = pc0 & ~1u; pc < pc1; pc += 2) {
+		switch (pc >> 24) {
+		case 0: if (pc < 0x4000) perf_lut_bios[pc >> 1] = val; break;
+		case 2: perf_lut_ewram[(pc & 0x3FFFF) >> 1] = val; break;
+		case 3: perf_lut_iwram[(pc & 0x7FFF) >> 1] = val; break;
+		}
+	}
+}
+void retro_perf_set_ctx(uint32_t c) { perf_ctx = c; ctx_sp = 0; }
+uint32_t retro_perf_get_ctx(void) { return perf_ctx | (ctx_sp << 8); }
+/* copy up to max pending snapshots into buf; returns count */
+int retro_perf_drain(void* buf, int max) {
+	int n = 0;
+	while (snap_r != snap_w && n < max) {
+		memcpy((char*) buf + n * sizeof(struct PerfSnap), &snaps[snap_r % PERF_NSNAP], sizeof(struct PerfSnap));
+		++snap_r; ++n;
+	}
+	return n;
+}
+uint32_t retro_perf_lost(void) { return snap_lost; }
+
+/* ---- memory wrappers */
+static inline void perf_acct(struct ARMCore* cpu, uint32_t address, int bytes, int* cc, int before, int base, int write) {
+	unsigned r = (address >> 24) & 15;
+	if (!cc) {
+		if (write) perfC.dma_wr_b[r] += bytes; else perfC.dma_rd_b[r] += bytes;
+		return;
+	}
+	int c = *cc - before;
+	int w = c - base;
+	perfC.memcyc[perf_key] += c;
+	perfC.memwait[perf_key] += w;
+	if (write) {
+		unsigned x = perf_ctx & 3; perfC.wr_n[x][r]++; perfC.wr_b[x][r] += bytes; perfC.wr_w[x][r] += w;
+		if (r == 6) {
+			struct GBA* gba = (struct GBA*) cpu->master;
+			uint16_t ds = gba->memory.io[GBA_REG(DISPSTAT)];
+			perfC.vram_wr_b[(ds & 1) ? 2 : (ds & 2) ? 1 : 0] += bytes;
+		}
+	} else {
+		unsigned x = perf_ctx & 3; perfC.rd_n[x][r]++; perfC.rd_b[x][r] += bytes; perfC.rd_w[x][r] += w;
+	}
+}
+
+#define WRAP_LOAD(NAME, ORIG, BYTES) \
+uint32_t ORIG(struct ARMCore* cpu, uint32_t address, int* cycleCounter); \
+uint32_t NAME(struct ARMCore* cpu, uint32_t address, int* cycleCounter) { \
+	int b = cycleCounter ? *cycleCounter : 0; \
+	uint32_t v = ORIG(cpu, address, cycleCounter); \
+	perf_acct(cpu, address, BYTES, cycleCounter, b, 2, 0); \
+	return v; }
+#define WRAP_STORE(NAME, ORIG, T, BYTES) \
+void ORIG(struct ARMCore* cpu, uint32_t address, T value, int* cycleCounter); \
+void NAME(struct ARMCore* cpu, uint32_t address, T value, int* cycleCounter) { \
+	int b = cycleCounter ? *cycleCounter : 0; \
+	ORIG(cpu, address, value, cycleCounter); \
+	perf_acct(cpu, address, BYTES, cycleCounter, b, 1, 1); }
+WRAP_LOAD(perfLoad32, GBALoad32, 4)
+WRAP_LOAD(perfLoad16, GBALoad16, 2)
+WRAP_LOAD(perfLoad8, GBALoad8, 1)
+WRAP_STORE(perfStore32, GBAStore32, int32_t, 4)
+WRAP_STORE(perfStore16, GBAStore16, int16_t, 2)
+WRAP_STORE(perfStore8, GBAStore8, int8_t, 1)
+
+uint32_t GBALoadMultiple(struct ARMCore* cpu, uint32_t address, int mask, enum LSMDirection direction, int* cycleCounter);
+uint32_t GBAStoreMultiple(struct ARMCore* cpu, uint32_t address, int mask, enum LSMDirection direction, int* cycleCounter);
+uint32_t perfLoadMultiple(struct ARMCore* cpu, uint32_t address, int mask, enum LSMDirection direction, int* cycleCounter) {
+	int b = cycleCounter ? *cycleCounter : 0;
+	uint32_t v = GBALoadMultiple(cpu, address, mask, direction, cycleCounter);
+	int n = __builtin_popcount(mask & 0xFFFF);
+	if (!n) n = 16;
+	perf_acct(cpu, address, 4 * n, cycleCounter, b, n + 1, 0);
+	return v;
+}
+uint32_t perfStoreMultiple(struct ARMCore* cpu, uint32_t address, int mask, enum LSMDirection direction, int* cycleCounter) {
+	int b = cycleCounter ? *cycleCounter : 0;
+	uint32_t v = GBAStoreMultiple(cpu, address, mask, direction, cycleCounter);
+	int n = __builtin_popcount(mask & 0xFFFF);
+	if (!n) n = 16;
+	perf_acct(cpu, address, 4 * n, cycleCounter, b, n, 1);
+	return v;
+}
