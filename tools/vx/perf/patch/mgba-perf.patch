+static inline void perf_post(struct ARMCore* cpu, uint32_t pc, uint16_t e, int32_t c0, uint32_t seqw) {
+	uint32_t k = perf_key;
+	perfC.cyc[k] += cpu->cycles - c0;
+	perfC.ins[k]++;
+	perfC.fetchwait[k] += seqw;
+	if (UNLIKELY(e & PERF_F_POP)) perf_pop();
+}
+
 static inline void ARMStep(struct ARMCore* cpu) {
+	uint32_t ppc = cpu->gprs[ARM_PC] - WORD_SIZE_ARM;
+	uint16_t pe = perf_lut(ppc);
+	if (UNLIKELY(pe & 0x1F00)) perf_event(cpu, ppc, pe);
+	perf_key = perf_ctx * PERF_NB + (pe & 63);
+	int32_t pc0 = cpu->cycles;
+	uint32_t pseq = cpu->memory.activeSeqCycles32;
+	perfC.fetch_b[(ppc >> 24) & 15] += 4;
 	uint32_t opcode = cpu->prefetch[0];
 	cpu->prefetch[0] = cpu->prefetch[1];
 	cpu->gprs[ARM_PC] += WORD_SIZE_ARM;
@@ -210,20 +229,30 @@
 		bool conditionMet = conditionLut[condition] & (1 << flags);
 		if (!conditionMet) {
 			cpu->cycles += ARM_PREFETCH_CYCLES;
+			perf_post(cpu, ppc, pe, pc0, pseq);
 			return;
 		}
 	}
 	ARMInstruction instruction = _armTable[((opcode >> 16) & 0xFF0) | ((opcode >> 4) & 0x00F)];
 	instruction(cpu, opcode);
+	perf_post(cpu, ppc, pe, pc0, pseq);
 }
 
 static inline void ThumbStep(struct ARMCore* cpu) {
+	uint32_t ppc = cpu->gprs[ARM_PC] - WORD_SIZE_THUMB;
+	uint16_t pe = perf_lut(ppc);
+	if (UNLIKELY(pe & 0x1F00)) perf_event(cpu, ppc, pe);
+	perf_key = perf_ctx * PERF_NB + (pe & 63);
+	int32_t pc0 = cpu->cycles;
+	uint32_t pseq = cpu->memory.activeSeqCycles16;
+	perfC.fetch_b[(ppc >> 24) & 15] += 2;
 	uint32_t opcode = cpu->prefetch[0];
 	cpu->prefetch[0] = cpu->prefetch[1];
 	cpu->gprs[ARM_PC] += WORD_SIZE_THUMB;
 	LOAD_16(cpu->prefetch[1], cpu->gprs[ARM_PC] & cpu->memory.activeMask, cpu->memory.activeRegion);
 	ThumbInstruction instruction = _thumbTable[opcode >> 6];
 	instruction(cpu, opcode);
+	perf_post(cpu, ppc, pe, pc0, pseq);
 }
 
 void ARMRun(struct ARMCore* cpu) {
