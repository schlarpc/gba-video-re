 };
 
-static inline void ARMStep(struct ARMCore* cpu) {
+
+#include <stdint.h>
+uint64_t retro_prof_iwram[0x2000], retro_prof_ewram[0x10000], retro_prof_rom[0x200000], retro_prof_bios[0x1000], retro_prof_vram[0x6000], retro_prof_other[16];
+uint64_t retro_prof_thumb[16], retro_prof_arm[16];
+int retro_prof_on = 1;
+uint32_t retro_bp_addr[8]; uint32_t retro_bp_regs[8][17]; uint32_t retro_bp_hits[8]; int retro_bp_n = 0; uint32_t retro_bp_log[4096][18]; uint32_t retro_bp_logn = 0;
+static inline void bp_check(struct ARMCore* cpu, uint32_t pc) {
+	for (int i = 0; i < retro_bp_n; i++) if (retro_bp_addr[i] == pc) {
+		retro_bp_hits[i]++;
+		for (int r = 0; r < 16; r++) retro_bp_regs[i][r] = cpu->gprs[r];
+		retro_bp_regs[i][16] = cpu->cpsr.packed;
+		if (retro_bp_logn < 4096) { uint32_t* L = retro_bp_log[retro_bp_logn++]; L[0] = i; for (int r = 0; r < 16; r++) L[1 + r] = cpu->gprs[r]; L[17] = cpu->cpsr.packed; }
+	}
+}
+static inline void prof_add(uint32_t pc, int32_t c, int thumb) {
+	if (!retro_prof_on) return;
+	unsigned r = (pc >> 24) & 15;
+	if (thumb) retro_prof_thumb[r] += c; else retro_prof_arm[r] += c;
+	switch (r) {
+	case 0: if (pc < 0x4000) { retro_prof_bios[pc >> 2] += c; return; } break;
+	case 2: retro_prof_ewram[(pc & 0x3FFFF) >> 2] += c; return;
+	case 3: retro_prof_iwram[(pc & 0x7FFF) >> 2] += c; return;
+	case 6: retro_prof_vram[((pc & 0x1FFFF) % 0x18000) >> 2] += c; return;
+	case 8: case 9: retro_prof_rom[(pc & 0x1FFFFFF) >> 4] += c; return;
+	}
+	retro_prof_other[r] += c;
+}
+static inline void ARMStep0(struct ARMCore* cpu) {
 	uint32_t opcode = cpu->prefetch[0];
 	cpu->prefetch[0] = cpu->prefetch[1];
 	cpu->gprs[ARM_PC] += WORD_SIZE_ARM;
@@ -217,7 +244,7 @@
 	instruction(cpu, opcode);
 }
 
-static inline void ThumbStep(struct ARMCore* cpu) {
+static inline void ThumbStep0(struct ARMCore* cpu) {
 	uint32_t opcode = cpu->prefetch[0];
 	cpu->prefetch[0] = cpu->prefetch[1];
 	cpu->gprs[ARM_PC] += WORD_SIZE_THUMB;
