+
+static inline void ARMStep(struct ARMCore* cpu) {
+	uint32_t ppc = cpu->gprs[ARM_PC] - WORD_SIZE_ARM; int32_t c0 = cpu->cycles; if (retro_bp_n) bp_check(cpu, ppc);
+	ARMStep0(cpu); prof_add(ppc, cpu->cycles - c0, 0);
+}
+static inline void ThumbStep(struct ARMCore* cpu) {
+	uint32_t ppc = cpu->gprs[ARM_PC] - WORD_SIZE_THUMB; int32_t c0 = cpu->cycles; if (retro_bp_n) bp_check(cpu, ppc);
+	ThumbStep0(cpu); prof_add(ppc, cpu->cycles - c0, 1);
+}
