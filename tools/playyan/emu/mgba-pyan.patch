Applies to the nixpkgs libretro.mgba source with 'patch -p1' (tools/playyan/emu/build.sh does it).
Adds the Play-Yan family cartridge (src/gba/cart/pyan.c): the register file, chip memory, transfer
modes and record IRQs of the Play-Yan, Play-Yan Micro and Nintendo MP3 Player, with hooks for the
Python models and for the VC01 / C54x emulators (LLE), the pixel window's RGB565 to BGR555 bridge
and the bus trace.

--- a/include/mgba/internal/gba/cart/pyan.h	1969-12-31 16:00:00.000000000 -0800
+++ b/include/mgba/internal/gba/cart/pyan.h	2026-11-07 23:12:27.608395743 -0800
@@ -0,0 +1,46 @@
+/* Play-Yan family cartridge model for mGBA -- tools/playyan/emu.
+ *
+ * Bus mechanics are modelled here in C (register file, VC/DSP memory, transfer modes, IRQ
+ * delivery, trace). High-level "firmware" behaviour (commands -> records, media decoding) lives
+ * in Python (tools/playyan/emu/pyan_model.py), reached through one event callback.
+ * Spec under test: docs/playyan/protocol.md. */
+#ifndef GBA_PYAN_H
+#define GBA_PYAN_H
+
+#include <mgba-util/common.h>
+
+CXX_GUARD_START
+
+struct GBA;
+
+enum {
+	PYAN_NONE = 0,
+	PYAN_ORIG = 1,   /* Play-Yan (ZMAJ) */
+	PYAN_MICRO = 2,  /* Play-Yan Micro (ZMBJ) */
+	PYAN_NMP = 3,    /* Nintendo MP3 Player (ZMDE) */
+};
+
+extern int GBAPYanFamily;
+
+bool GBAPYanDetect(struct GBA* gba);
+void GBAPYanReset(struct GBA* gba);
+
+static inline bool GBAPYanClaims(uint32_t address) {
+	if (!GBAPYanFamily) {
+		return false;
+	}
+	uint32_t r = address >> 24;
+	if (GBAPYanFamily == PYAN_NMP) {
+		return r == 0x0E || r == 0x0F;
+	}
+	return r == 0x09 || r == 0x0B || r == 0x0D;
+}
+
+uint32_t GBAPYanLoad(struct GBA* gba, uint32_t address, int width);
+void GBAPYanStore(struct GBA* gba, uint32_t address, uint32_t value, int width);
+/* NMP GPIO (0x080000C4/C6/C8) writes; returns true if consumed */
+bool GBAPYanGPIOWrite(struct GBA* gba, uint32_t address, uint16_t value);
+
+CXX_GUARD_END
+
+#endif
